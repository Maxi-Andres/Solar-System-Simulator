{
  "name": "@sss/tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./types": "./src/types.ts",
    "./catalog": "./src/catalog.ts",
    "./config": "./src/config.ts",
    "./satellites/named": "./src/satellites/named.ts"
  },
  "description": "Static ephemeris generator backed by the JPL Horizons API",
  "scripts": {
    "fetch:data": "node src/fetchData.ts",
    "fetch:belt": "node src/belt/fetchBelt.ts",
    "fetch:satellites": "node src/satellites/fetchSatellites.ts",
    "fetch:stars": "node src/stars/fetchStars.ts",
    "write:catalog": "node src/writeCatalog.ts",
    "moons:list": "node src/moons/buildMoonList.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "astronomy-engine": "2.1.19",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "satellite.js": "^7.1.0"
  }
}
