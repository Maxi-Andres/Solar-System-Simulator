{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],

    // Explicit file extensions on imports, same as tools/. Vite resolves them fine,
    // which keeps both halves of the monorepo on one convention.
    "allowImportingTsExtensions": true
  },
  "include": ["src", "vite.config.ts"]
}
